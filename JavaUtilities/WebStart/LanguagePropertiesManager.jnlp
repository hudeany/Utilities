<?xml version="1.0" encoding="utf-8"?>
<jnlp spec="1.0+" codebase="http://www.soderer.de/files/download/javawebstart/" href="jnlp/LanguagePropertiesManager.jnlp">
	<information>
		<title>LanguagePropertiesManager</title>
		<version>1.0.0</version>
		<vendor>www.soderer.de</vendor>
		<homepage href="http://www.soderer.de" />
		<description>LanguagePropertiesManager</description>
    <icon href="LanguagePropertiesManager.gif"/> 
		<offline-allowed />
	</information>

	<security>
		<all-permissions />
	</security>
	
	<resources>
		<j2se version="1.6+" />
		<jar href="LanguagePropertiesManager.jar" />
		<jar href="utilities-1.1.0.jar" />
		<jar href="commons-collections-3.2.1.jar" />
		<jar href="commons-io-1.3.2.jar" />
		<jar href="commons-lang3-3.1.jar" />
	</resources>

	<resources os="Windows" arch="x86">
		<jar href="swt-3.7.2-win32-win32-x86.jar" />
	</resources>

	<resources os="Windows" arch="x86_64">
		<jar href="swt-3.7.2-win32-win32-x86_64.jar" />
	</resources>

	<resources os="Windows" arch="amd64">
		<jar href="swt-3.7.2-win32-win32-x86_64.jar" />
	</resources>

	<resources os="Linux" arch="x86_64">
		<jar href="swt-3.7.2-gtk-linux-x86_64.jar" />
	</resources>

	<resources os="Linux" arch="amd64">
		<jar href="swt-3.7.2-gtk-linux-x86_64.jar" />
	</resources>

	<resources os="Linux">
		<jar href="swt-3.7.2-gtk-linux-x86.jar" />
	</resources>

	<application-desc main-class="de.soderer.languagepropertiesmanager.main.Application" />
</jnlp>