<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project default="build_jar" name="Build library JavaUtilities">
	<!-- ===== Project specific part ===== -->

	<!-- Artifact name used for the jar file names and the Maven artifactId -->
	<property name="artifactId" value="soderer-utilities" />

	<!-- Dependency versions -->
	<property name="activation.version" value="1.1.1" />
	<property name="jakarta.activation-api.version" value="2.1.4" />
	<property name="jakarta.xml.bind-api.version" value="3.0.1" />
	<property name="commons-lang3.version" value="3.11" />
	<property name="commons-io.version" value="2.8.0" />
	<property name="commons-compress.version" value="1.23.0" />
	<property name="commons-text.version" value="1.9" />
	<property name="commons-net.version" value="3.7.1" />
	<property name="jakarta.mail-api.version" value="2.1.5" />
	<property name="angus-mail.version" value="2.0.5" />
	<property name="angus-activation.version" value="2.0.3" />
	<property name="jsch.version" value="0.2.23" />
	<property name="bouncycastle.version" value="1.86" />
	<property name="smbj.version" value="0.10.0" />
	<property name="jcifs.version" value="1.3.18.1" />
	<property name="jna.version" value="5.6.0" />
	<property name="java-jwt.version" value="3.13.0" />
	<property name="slf4j.version" value="1.7.36" />
	<property name="zip4j.version" value="2.11.5" />

	<property name="csv.version" value="26.1.9" />
	<property name="json.version" value="26.2.8" />
	<property name="network.version" value="26.0.37" />
	<property name="dkim.version" value="26.1.6" />
	<property name="proxyautoconfig.version" value="26.1.4" />

	<!-- Special: AntBuildHelp is used to download the runtime libraries -->
	<property name="antbuildhelp.version" value="26.0.9" />

	<available file="lib_build/antbuildhelp-${antbuildhelp.version}.jar" property="antbuildhelp.available" />
	<target name="get_antbuildhelp" unless="antbuildhelp.available">
		<mkdir dir="lib_build/" />
		<delete>
			<fileset dir="lib_build" includes="antbuildhelp-*.jar" />
		</delete>
		<get src="https://github.com/hudeany/antbuildhelp/releases/download/${antbuildhelp.version}/antbuildhelp-${antbuildhelp.version}.jar" dest="lib_build/" />
	</target>

	<target name="register_antbuildhelp" depends="get_antbuildhelp">
		<typedef resource="de/soderer/antbuildhelp/antlib.xml" classpath="lib_build/antbuildhelp-${antbuildhelp.version}.jar" />
	</target>

	<!-- Runtime libraries of this project go to "lib/" (may stay empty) -->
	<target name="download_dependencies" depends="register_antbuildhelp">
		<getMavenDependency groupId="javax.activation" artifactId="activation" version="${activation.version}" />
		<getMavenDependency groupId="jakarta.activation" artifactId="jakarta.activation-api" version="${jakarta.activation-api.version}" />
		<getMavenDependency groupId="jakarta.xml.bind" artifactId="jakarta.xml.bind-api" version="${jakarta.xml.bind-api.version}" />

		<getMavenDependency groupId="org.apache.commons" artifactId="commons-lang3" version="${commons-lang3.version}" />
		<getMavenDependency groupId="commons-io" artifactId="commons-io" version="${commons-io.version}" />
		<getMavenDependency groupId="org.apache.commons" artifactId="commons-compress" version="${commons-compress.version}" />
		<getMavenDependency groupId="org.apache.commons" artifactId="commons-text" version="${commons-text.version}" />
		<getMavenDependency groupId="commons-net" artifactId="commons-net" version="${commons-net.version}" />

		<getMavenDependency groupId="jakarta.mail" artifactId="jakarta.mail-api" version="${jakarta.mail-api.version}" />
		<getMavenDependency groupId="org.eclipse.angus" artifactId="angus-mail" version="${angus-mail.version}" />
		<getMavenDependency groupId="org.eclipse.angus" artifactId="angus-activation" version="${angus-activation.version}" />

		<getMavenDependency groupId="com.github.mwiede" artifactId="jsch" version="${jsch.version}" />

		<getMavenDependency groupId="org.bouncycastle" artifactId="bcprov-jdk18on" version="${bouncycastle.version}" />
		<getMavenDependency groupId="org.bouncycastle" artifactId="bcpkix-jdk18on" version="${bouncycastle.version}" />
		<getMavenDependency groupId="org.bouncycastle" artifactId="bcutil-jdk18on" version="${bouncycastle.version}" />
		<getMavenDependency groupId="org.bouncycastle" artifactId="bcpg-jdk18on" version="${bouncycastle.version}" />
		<getMavenDependency groupId="org.bouncycastle" artifactId="bcjmail-jdk18on" version="${bouncycastle.version}" />

		<getMavenDependency groupId="com.hierynomus" artifactId="smbj" version="${smbj.version}" />
		<getMavenDependency groupId="org.codelibs" artifactId="jcifs" version="${jcifs.version}" />

		<getMavenDependency groupId="net.java.dev.jna" artifactId="jna" version="${jna.version}" />
		<getMavenDependency groupId="net.java.dev.jna" artifactId="jna-platform" version="${jna.version}" />

		<getMavenDependency groupId="com.auth0" artifactId="java-jwt" version="${java-jwt.version}" />
		<getMavenDependency groupId="net.lingala.zip4j" artifactId="zip4j" version="${zip4j.version}" />

		<getDependency name="csv" version="${csv.version}" url="https://github.com/hudeany/csv/releases/download/{version}/csv-{version}.jar" />
		<getDependency name="json" version="${json.version}" url="https://github.com/hudeany/json/releases/download/{version}/json-{version}.jar" />
		<getDependency name="proxyautoconfig" version="${proxyautoconfig.version}" url="https://github.com/hudeany/ProxyAutoConfig/releases/download/{version}/proxyautoconfig-{version}.jar" />
		<getMavenDependency repositoryUrl="https://soderer.de/maven2" groupId="de.soderer" artifactId="network" version="${network.version}" />
		<getMavenDependency repositoryUrl="https://soderer.de/maven2" groupId="de.soderer" artifactId="dkim" version="${dkim.version}" />
	</target>

	<!-- ===== Common part: identical in all library build files, do not change per project ===== -->

	<echo message="Java Version: ${java.version}" />
	<echo message="Ant Version: ${ant.version}" />

	<!-- Strip line breaks so a trailing newline in build.version does not end up in file names -->
	<loadfile property="version" srcFile="build.version" failonerror="false">
		<filterchain>
			<striplinebreaks />
		</filterchain>
	</loadfile>
	<property name="version" value="noVersion" />

	<echo message="artifactId: ${artifactId}" />
	<echo message="version (build.version): ${version}" />

	<property name="buildPath" value="build" />
	<echo message="buildPath: ${buildPath}" />

	<!-- Runtime libraries; an empty or missing "lib/" directory is fine -->
	<path id="runtime.libs">
		<fileset dir="lib" erroronmissingdir="false">
			<include name="*.jar" />
		</fileset>
	</path>

	<!-- Test libraries, same for all libraries -->
	<target name="download_test_dependencies">
		<mkdir dir="lib_test/" />
		<delete includeEmptyDirs="true">
			<fileset dir="lib_test/">
				<include name="*" />
			</fileset>
		</delete>

		<get src="https://repo1.maven.org/maven2/org/hamcrest/hamcrest/3.0/hamcrest-3.0.jar" dest="lib_test/" />
		<get src="https://repo1.maven.org/maven2/org/junit/jupiter/junit-jupiter-api/6.0.3/junit-jupiter-api-6.0.3.jar" dest="lib_test/" />
		<get src="https://repo1.maven.org/maven2/org/junit/jupiter/junit-jupiter-engine/6.0.3/junit-jupiter-engine-6.0.3.jar" dest="lib_test/" />
		<get src="https://repo1.maven.org/maven2/org/junit/jupiter/junit-jupiter-params/6.0.3/junit-jupiter-params-6.0.3.jar" dest="lib_test/" />
		<get src="https://repo1.maven.org/maven2/org/junit/platform/junit-platform-launcher/6.0.3/junit-platform-launcher-6.0.3.jar" dest="lib_test/" />
		<get src="https://repo1.maven.org/maven2/org/junit/platform/junit-platform-engine/6.0.3/junit-platform-engine-6.0.3.jar" dest="lib_test/" />
		<get src="https://repo1.maven.org/maven2/org/junit/platform/junit-platform-commons/6.0.3/junit-platform-commons-6.0.3.jar" dest="lib_test/" />
		<get src="https://repo1.maven.org/maven2/org/opentest4j/opentest4j/1.3.0/opentest4j-1.3.0.jar" dest="lib_test/" />
		<get src="https://repo1.maven.org/maven2/org/apiguardian/apiguardian-api/1.1.2/apiguardian-api-1.1.2.jar" dest="lib_test/" />
	</target>

	<target name="build_jar" depends="cleanup_before, create_jar, test, create_javadoc, cleanup_after" />

	<target name="cleanup_before">
		<mkdir dir="${buildPath}" />

		<delete includeEmptyDirs="true">
			<fileset dir="${buildPath}">
				<include name="*" />
			</fileset>
		</delete>

		<delete dir="${buildPath}/bin" />
		<mkdir dir="${buildPath}/bin" />

		<delete dir="${buildPath}/testbin" />
		<mkdir dir="${buildPath}/testbin" />
	</target>

	<target name="create_jar" depends="cleanup_before, download_dependencies">
		<javac release="17" srcdir="src/main/java" destdir="${buildPath}/bin" includeantruntime="false" encoding="UTF-8" debug="true" deprecation="false" nowarn="true">
			<classpath refid="runtime.libs" />
			<compilerarg value="-Xlint:unchecked" />
			<compilerarg value="-parameters" />
		</javac>

		<copy todir="${buildPath}/bin">
			<fileset dir="src/main/resources" erroronmissingdir="false" />
		</copy>

		<jar destfile="${buildPath}/${artifactId}-${version}.jar">
			<manifest>
				<attribute name="Version" value="${version}" />
			</manifest>

			<fileset dir="${buildPath}/bin" />
			<fileset dir="" includes="LICENSE.txt" />
		</jar>

		<jar destfile="${buildPath}/${artifactId}-${version}-sources.jar">
			<manifest>
				<attribute name="Version" value="${version}" />
			</manifest>

			<fileset dir="src/main/java" includes="**/*.java" />
			<fileset dir="" includes="LICENSE.txt" />
		</jar>
	</target>

	<target name="test" depends="create_jar, download_test_dependencies">
		<path id="test.classpath">
			<fileset dir="lib_test">
				<include name="*.jar" />
			</fileset>
			<path refid="runtime.libs" />
			<pathelement location="${buildPath}/${artifactId}-${version}.jar" />
			<pathelement location="${buildPath}/testbin" />
		</path>

		<javac release="17" srcdir="src/test/java" destdir="${buildPath}/testbin" includeantruntime="false" encoding="UTF-8" debug="true" failonerror="true">
			<classpath refid="test.classpath" />
			<include name="**/*.java" />
		</javac>

		<copy todir="${buildPath}/testbin">
			<fileset dir="src/test/resources" erroronmissingdir="false" />
		</copy>

		<junitlauncher printSummary="true" failureProperty="test.failed">
			<classpath refid="test.classpath" />
			<testclasses outputdir="${buildPath}">
				<fileset dir="${buildPath}/testbin">
					<include name="**/*.class" />
					<!-- Special: tests that need manual interaction are skipped (as in the former surefire configuration) -->
					<exclude name="**/*ManuallyTest*.class" />
				</fileset>
				<!-- Writes a report per test class to TEST-*.txt, including details of failed tests -->
				<listener type="legacy-brief" sendSysOut="false" sendSysErr="false" />
			</testclasses>
		</junitlauncher>

		<!-- Show which tests failed and why before stopping the build (only reports with failures or errors) -->
		<concat if:set="test.failed" xmlns:if="ant:if">
			<fileset dir="${buildPath}" includes="TEST-*.txt">
				<or>
					<contains text="FAILED" />
					<contains text="Caused an ERROR" />
				</or>
			</fileset>
		</concat>
		<fail if="test.failed" message="Tests failed!" />
	</target>

	<target name="create_javadoc" depends="create_jar">
		<delete dir="${buildPath}/javadoc" />
		<mkdir dir="${buildPath}/javadoc" />

		<javadoc destdir="${buildPath}/javadoc" encoding="UTF-8" charset="UTF-8" docencoding="UTF-8" source="17" failonerror="true">
			<classpath refid="runtime.libs" />
			<arg value="-quiet" />
			<fileset dir="src/main/java" includes="**/*.java" />
		</javadoc>

		<jar destfile="${buildPath}/${artifactId}-${version}-javadoc.jar">
			<manifest>
				<attribute name="Version" value="${version}" />
			</manifest>

			<fileset dir="${buildPath}/javadoc" />
			<fileset dir="" includes="LICENSE.txt" />
		</jar>

		<delete dir="${buildPath}/javadoc" />
	</target>

	<target name="cleanup_after" depends="test, create_javadoc">
		<delete dir="${buildPath}/bin" />
		<delete dir="${buildPath}/testbin" />

		<delete includeEmptyDirs="true">
			<fileset dir="${buildPath}">
				<include name="TEST-*" />
			</fileset>
		</delete>
	</target>
</project>
